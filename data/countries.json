    "system": "AMNOG early benefit assessment",
    "process": [
      "Company submits a benefit dossier at launch",
      "IQWiG assesses the added benefit",
      "G-BA decides the extent of added benefit",
      "GKV-Spitzenverband negotiates the reimbursement amount (Erstattungsbetrag)"
    ],
    "rating": "Added benefit: major, considerable, minor, non-quantifiable, not proven, or less benefit",
    "news_feeds": [
      {
        "name": "G-BA – benefit assessments (latest changes)",
